#!/usr/bin/env bash
# Лаборатория 3Д на Linux: управление сервером - то же, что server.bat / Lab3D.exe на Windows.
#
#   lab3d                      # статус
#   lab3d start|stop|restart [all|site|crm|slicer|panel|bambuddy|caddy]
#   lab3d logs [site|site-errors|crm|crm-errors|slicer|panel|caddy|bambuddy]
#   lab3d update [--force]     # git pull, зависимости, база, сборка, перезапуск
#   lab3d backup [папка]       # все данные сайта и «Заказов» в один архив
#   lab3d restore <архив>      # вернуть данные из бэкапа (заменяет текущие)
#   lab3d slicer               # установить / переустановить OrcaSlicer для цен
#   lab3d slicer-test          # проверить нарезку целиком (слайсер -> Bambuddy -> кубик)
#   lab3d db-push              # применить схему базы вручную (с вопросом о рисках)
#   lab3d panel-password       # пароль веб-панели (panel.<домен>)
#   lab3d panel-on|panel-off   # включить / выключить веб-панель
#   lab3d config               # пересоздать службы systemd и конфиг Caddy
#   lab3d shop-domain [домен]  # домен магазина TACLAB (пусто - только /shop на основном сайте)
#
# deploy/linux/install.sh ставит копию этого файла в /usr/local/sbin/lab3d (владелец root, путь к
# проекту вписан). Копия, а не ссылка: файлы проекта принадлежат пользователю lab3d, от имени
# которого работает сайт, и root не должен исполнять то, что этот пользователь может поменять.
set -euo pipefail

ROOT="@LAB3D_ROOT@"
# Запуск прямо из репозитория (до установки): проект - на две папки выше.
# Метка в проверке записана шаблоном, а не полностью: установка заменяет sed-ом каждое вхождение
# полной метки, и проверка с ней стала бы всегда истинной (тогда ROOT был бы /usr).
[[ $ROOT == @*@ ]] && ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)
[[ -f $ROOT/package.json && -d $ROOT/deploy/linux ]] || { echo "lab3d: не найден проект в $ROOT" >&2; exit 1; }

APP_USER=lab3d
APP_HOME=/var/lib/lab3d
ENV_FILE=$ROOT/.env.production
LAB=$ROOT/lab
LAB_ENV=$LAB/.env
LOG_DIR=$ROOT/deploy/logs
LAB_LOG_DIR=$LAB/deploy/logs
SLICER_DIR=$ROOT/deploy/slicer
# Конфиг Caddy пишется прямо в /etc/caddy, не в папку проекта: блок глобальных настроек (режим без
# домена) Caddy принимает только в начале главного файла, и пользователь caddy может не видеть проект.
CADDY_FILE=/etc/caddy/Caddyfile
CADDY_EXTRA_D=/etc/caddy/lab3d.d
INSTALLED_CLI=/usr/local/sbin/lab3d
SUDOERS=/etc/sudoers.d/lab3d-panel
UNIT_DIR=/etc/systemd/system

# ---------------------------------------------------------------- вывод

if [[ -t 1 ]]; then C_STEP=$'\e[36m' C_OK=$'\e[32m' C_WARN=$'\e[33m' C_BAD=$'\e[31m' C_DIM=$'\e[90m' C_END=$'\e[0m'
else C_STEP="" C_OK="" C_WARN="" C_BAD="" C_DIM="" C_END=""; fi
step() { printf '%s==> %s%s\n' "$C_STEP" "$*" "$C_END"; }
ok() { printf '%s    %s%s\n' "$C_OK" "$*" "$C_END"; }
warn() { printf '%s    ! %s%s\n' "$C_WARN" "$*" "$C_END"; }
bad() { printf '%s    × %s%s\n' "$C_BAD" "$*" "$C_END" >&2; }
die() { bad "$*"; exit 1; }
dim() { printf '%s    %s%s\n' "$C_DIM" "$*" "$C_END"; }

need_root() { [[ $EUID -eq 0 ]] || exec sudo "$0" "$@"; }

# ---------------------------------------------------------------- .env файлы
# Формат как у Windows-скриптов: KEY="VALUE". Через source их читать нельзя: в значениях бывает $
# (хэш пароля панели), bash бы его раскрыл.

env_get() { # FILE KEY
  [[ -f $1 ]] || return 0
  tr -d '\r' < "$1" | sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" | tail -n1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/'
}

env_set() { # FILE KEY VALUE
  local file=$1 key=$2 value=$3 tmp
  [[ $value != *'"'* && $value != *$'\n'* ]] || die "Недопустимое значение для $key"
  tmp=$(mktemp)
  if [[ -f $file ]]; then
    awk -v k="$key" -v v="$value" 'BEGIN { done = 0 }
      $0 ~ "^[[:space:]]*" k "[[:space:]]*=" { if (!done) print k "=\"" v "\""; done = 1; next }
      { print } END { if (!done) print k "=\"" v "\"" }' "$file" > "$tmp"
    cat "$tmp" > "$file"
  else
    printf '# Created by deploy/linux - safe to edit; restart to apply.\n%s="%s"\n' "$key" "$value" > "$file"
  fi
  rm -f "$tmp"
}

env_unset() { # FILE KEY
  [[ -f $1 ]] || return 0
  local tmp; tmp=$(mktemp)
  grep -v "^[[:space:]]*$2[[:space:]]*=" "$1" > "$tmp" || true
  cat "$tmp" > "$1"; rm -f "$tmp"
}

# KEY=VALUE для env(1): переменные .env.production для node/npm/prisma.
env_args() { # FILE
  [[ -f $1 ]] || return 0
  tr -d '\r' < "$1" | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=[[:space:]]*\(.*\)$/\1=\2/p' |
    sed -e 's/[[:space:]]*$//' -e 's/^\([^=]*\)="\(.*\)"$/\1=\2/'
}

# Команда от имени пользователя сайта, с переменными .env.production и в папке проекта.
as_app() {
  local -a vars=()
  mapfile -t vars < <(env_args "$ENV_FILE")
  ( cd "$ROOT" && runuser -u "$APP_USER" -- env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$APP_HOME" LANG=C.UTF-8 "${vars[@]}" "$@" )
}

# То же, но без переменных сайта и в указанной папке (lab, слайсер).
as_user_in() { # DIR CMD...
  local dir=$1; shift
  ( cd "$dir" && runuser -u "$APP_USER" -- env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$APP_HOME" LANG=C.UTF-8 "$@" )
}

domain() { env_get "$ENV_FILE" DEPLOY_DOMAIN; }
base_domain() { local d; d=$(domain); echo "${d#www.}"; }
app_port() { local p; p=$(env_get "$ENV_FILE" APP_PORT); echo "${p:-3000}"; }
crm_port() { local p; p=$(env_get "$LAB_ENV" PORT); echo "${p:-3001}"; }
panel_port() { local p; p=$(env_get "$ENV_FILE" PANEL_PORT); echo "${p:-3100}"; }
bambuddy_port() {
  local url port; url=$(env_get "$ENV_FILE" BAMBUDDY_URL)
  port=$(sed -n 's#^[a-z]*://[^/:]*:\([0-9][0-9]*\).*#\1#p' <<<"$url")
  echo "${port:-8000}"
}
panel_enabled() { [[ $(env_get "$ENV_FILE" PANEL_ENABLED) == 1 ]]; }

# Версии слайсера закреплены в deploy/lib.ps1 - одно место для Windows и Linux.
pinned() { sed -n "s/^\$script:$1 = \"\([^\"]*\)\".*/\1/p" "$ROOT/deploy/lib.ps1" | head -n1; }
slicer_port() { sed -n 's/^\$script:SlicerPort = \([0-9]*\).*/\1/p' "$ROOT/deploy/lib.ps1" | head -n1; }
slicer_tag() { echo "orca-$(pinned SlicerOrcaVersion)|$(pinned SlicerApiCommit)"; }
slicer_installed() { [[ -x $SLICER_DIR/orca/AppRun && -f $SLICER_DIR/api/dist/src/index.js ]]; }
slicer_current() { slicer_installed && [[ -f $SLICER_DIR/version.txt && $(<"$SLICER_DIR/version.txt") == "$(slicer_tag)" ]]; }

# Настройки под Linux поверх .env-файлов - новых или перенесённых с Windows (install.sh, restore).
apply_env() { # DOMAIN DATABASE_URL
  local DOMAIN=$1 DATABASE_URL=$2 IP BASE_URL
  IP=$(hostname -I | awk '{print $1}')
  BASE_URL=$([[ -n $DOMAIN ]] && echo "https://$DOMAIN" || echo "https://$IP")
  touch "$ENV_FILE" "$LAB_ENV"
  # Файлы с Windows - с переводами строк CRLF; systemd и bash их так не поймут.
  sed -i 's/\r$//' "$ENV_FILE" "$LAB_ENV"
  env_set "$ENV_FILE" DATABASE_URL "$DATABASE_URL"
  [[ -n $(env_get "$ENV_FILE" AUTH_SECRET) && $(env_get "$ENV_FILE" AUTH_SECRET) != replace-with* ]] ||
    env_set "$ENV_FILE" AUTH_SECRET "$(openssl rand -base64 48 | tr -d '\n')"
  env_set "$ENV_FILE" AUTH_TRUST_HOST true
  env_set "$ENV_FILE" APP_URL "$BASE_URL"
  env_set "$ENV_FILE" NEXT_PUBLIC_APP_URL "$BASE_URL"
  env_set "$ENV_FILE" DEPLOY_DOMAIN "$DOMAIN"
  env_set "$ENV_FILE" DEPLOY_IP "$IP"
  [[ -n $(env_get "$ENV_FILE" APP_PORT) ]] || env_set "$ENV_FILE" APP_PORT 3000
  [[ -n $(env_get "$ENV_FILE" NEXT_PUBLIC_RUB_PER_USD) ]] || env_set "$ENV_FILE" NEXT_PUBLIC_RUB_PER_USD 90
  [[ -n $(env_get "$ENV_FILE" BAMBUDDY_URL) ]] || env_set "$ENV_FILE" BAMBUDDY_URL http://127.0.0.1:8000
  grep -q '^BAMBUDDY_API_KEY=' "$ENV_FILE" || env_set "$ENV_FILE" BAMBUDDY_API_KEY ""
  # Пути программ с Windows здесь не нужны.
  env_unset "$ENV_FILE" DEPLOY_NODE; env_unset "$ENV_FILE" DEPLOY_CADDY
  # Веб-панель работала на Windows (пароль перенесён) - включаем и здесь.
  if [[ -n $(env_get "$ENV_FILE" PANEL_PASSWORD) && -n $DOMAIN && -z $(env_get "$ENV_FILE" PANEL_ENABLED) ]]; then
    env_set "$ENV_FILE" PANEL_ENABLED 1
  fi
  [[ -n $(env_get "$LAB_ENV" PORT) ]] || env_set "$LAB_ENV" PORT 3001
  [[ -n $(env_get "$LAB_ENV" DEPLOY_DOMAIN) || -z $DOMAIN ]] || env_set "$LAB_ENV" DEPLOY_DOMAIN "crm.${DOMAIN#www.}"
  [[ -z $DOMAIN ]] || env_set "$LAB_ENV" SITE_URL "https://$DOMAIN"
  env_unset "$LAB_ENV" DEPLOY_NODE; env_unset "$LAB_ENV" NEW_LAB_3D_ROOT
  [[ -n $(env_get "$ENV_FILE" LAB_API_URL) ]] || env_set "$ENV_FILE" LAB_API_URL "http://127.0.0.1:$(crm_port)"
  chown "$APP_USER:$APP_USER" "$ENV_FILE" "$LAB_ENV"; chmod 600 "$ENV_FILE" "$LAB_ENV"
  local crm; crm=$(env_get "$LAB_ENV" DEPLOY_DOMAIN)
  ok "сайт: $BASE_URL${crm:+ · «Заказы»: https://$crm}"
}

# ---------------------------------------------------------------- службы

unit_of() {
  case $1 in
    site) echo lab3d-site ;; crm) echo lab3d-crm ;; slicer) echo lab3d-slicer ;; panel) echo lab3d-panel ;;
    bambuddy) echo bambuddy ;; caddy) echo caddy ;;
    *) die "Неизвестная служба: $1 (site, crm, slicer, panel, bambuddy, caddy)" ;;
  esac
}
unit_exists() { [[ -n $(systemctl list-unit-files --no-legend "$1.service" 2>/dev/null) ]]; }
unit_state() { systemctl is-active "$1" 2>/dev/null || true; }

# Логи служб - файлами, как на Windows: их же показывает веб-панель.
ensure_log_files() {
  install -d -o "$APP_USER" -g "$APP_USER" "$LOG_DIR" "$LAB_LOG_DIR"
  local f
  for f in "$LOG_DIR"/{next,next-error,slicer,slicer-error,panel,panel-error}.log "$LAB_LOG_DIR"/{app,app-error}.log; do
    [[ -e $f ]] || install -m 640 -o "$APP_USER" -g "$APP_USER" /dev/null "$f"
  done
}

write_unit() { # NAME DESCRIPTION WORKDIR EXEC LOG ERRLOG [EXTRA...] - Condition* lines go to [Unit]
  local name=$1 desc=$2 dir=$3 exec=$4 log=$5 err=$6 line; shift 6
  {
    echo "# Generated by lab3d config - edits are overwritten."
    echo "[Unit]"
    echo "Description=$desc"
    echo "After=network-online.target postgresql.service"
    echo "Wants=network-online.target"
    for line in "$@"; do [[ $line == Condition* ]] && echo "$line"; done
    echo "[Service]"
    echo "Type=simple"
    echo "User=$APP_USER"
    echo "Group=$APP_USER"
    echo "WorkingDirectory=$dir"
    for line in "$@"; do [[ $line == Condition* ]] || echo "$line"; done
    echo "ExecStart=$exec"
    echo "Restart=always"
    echo "RestartSec=3"
    echo "StandardOutput=append:$log"
    echo "StandardError=append:$err"
    echo "[Install]"
    echo "WantedBy=multi-user.target"
  } > "$UNIT_DIR/$name.service"
}

write_units() {
  local node; node=$(command -v node) || die "Node.js не найден"
  write_unit lab3d-site "Лаборатория 3Д: сайт" "$ROOT" \
    "$node $ROOT/node_modules/next/dist/bin/next start -H 127.0.0.1 -p $(app_port)" \
    "$LOG_DIR/next.log" "$LOG_DIR/next-error.log" \
    "EnvironmentFile=$ENV_FILE" "Environment=NODE_ENV=production" "Environment=HOME=$APP_HOME"
  write_unit lab3d-crm "Лаборатория 3Д: «Заказы» (CRM)" "$LAB" "$node server.js" \
    "$LAB_LOG_DIR/app.log" "$LAB_LOG_DIR/app-error.log" \
    "EnvironmentFile=$LAB_ENV" "Environment=NODE_ENV=production" "Environment=HOME=$APP_HOME"
  write_unit lab3d-slicer "Лаборатория 3Д: OrcaSlicer для цен (обёртка для Bambuddy)" "$SLICER_DIR/api" \
    "$node $ROOT/deploy/slicer-api.mjs" "$LOG_DIR/slicer.log" "$LOG_DIR/slicer-error.log" \
    "ConditionPathExists=$SLICER_DIR/api/dist/src/index.js" \
    "Environment=NODE_ENV=production" "Environment=HOME=$APP_HOME" "Environment=PORT=$(slicer_port)" \
    "Environment=ORCASLICER_PATH=$SLICER_DIR/orca/AppRun" "Environment=DATA_PATH=$SLICER_DIR/data"
  write_unit lab3d-panel "Лаборатория 3Д: веб-панель управления" "$ROOT" "$node $ROOT/deploy/panel.mjs" \
    "$LOG_DIR/panel.log" "$LOG_DIR/panel-error.log" "Environment=HOME=$APP_HOME"
  systemctl daemon-reload
}

caddy_site() { # HOST PORT BODY_LIMIT [extra header line]
  cat <<EOF
$1 {
	encode zstd gzip
	request_body {
		max_size $3
	}
	reverse_proxy 127.0.0.1:$2
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server${4:+
		$4}
	}
}

EOF
}

write_caddy() {
  local d base crm tmp out
  d=$(domain); base=$(base_domain); crm=$(env_get "$LAB_ENV" DEPLOY_DOMAIN)
  install -d -m 755 "$CADDY_EXTRA_D"
  tmp=$(mktemp /etc/caddy/.Caddyfile.XXXXXX)
  {
    echo "# Generated by lab3d config from $ENV_FILE and $LAB_ENV - edits are overwritten."
    echo "# Own additions go to $CADDY_EXTRA_D/*.caddy."
    echo
    if [[ -n $d ]]; then
      caddy_site "$d" "$(app_port)" 600MB
      [[ -n $crm ]] && caddy_site "$crm" "$(crm_port)" 100MB
      caddy_site "bambu.$base" "$(bambuddy_port)" 1GB
      panel_enabled && caddy_site "panel.$base" "$(panel_port)" 1MB 'X-Robots-Tag "noindex, nofollow"'
      # Магазин TACLAB - то же приложение; proxy.ts по домену показывает на нём только магазин.
      local shop
      for shop in $(env_get "$ENV_FILE" TACLAB_DOMAIN | tr ',' ' '); do caddy_site "$shop" "$(app_port)" 10MB; done
    else
      # Без домена - HTTPS на IP с сертификатом от собственного центра Caddy (браузер предупредит).
      local ip; ip=$(hostname -I | awk '{print $1}')
      printf '{\n\tlocal_certs\n\tdefault_sni %s\n}\n\nhttps://%s {\n\ttls internal\n\trequest_body {\n\t\tmax_size 600MB\n\t}\n\treverse_proxy 127.0.0.1:%s\n}\n\n' "$ip" "$ip" "$(app_port)"
    fi
    echo "import $CADDY_EXTRA_D/*.caddy"
  } > "$tmp"
  chmod 644 "$tmp"
  # Проверяем до замены: неверный конфиг не должен попасть на место рабочего.
  if ! out=$(caddy validate --config "$tmp" --adapter caddyfile 2>&1); then
    rm -f "$tmp"
    grep -iE "error|fail" <<<"$out" | tail -n 5 | sed 's/^/      /' >&2
    die "Конфиг Caddy не прошёл проверку - $CADDY_FILE не изменён."
  fi
  if [[ -f $CADDY_FILE && ! -f $CADDY_FILE.lab3d-orig ]] && ! grep -q "Generated by lab3d" "$CADDY_FILE"; then
    cp "$CADDY_FILE" "$CADDY_FILE.lab3d-orig"
  fi
  mv "$tmp" "$CADDY_FILE"
  systemctl enable caddy >/dev/null 2>&1 || true
  # Горячая перезагрузка, а если не вышло (например, поверх стандартного конфига) - полный перезапуск.
  if ! { systemctl is-active -q caddy && systemctl reload caddy 2>/dev/null; }; then
    if ! systemctl restart caddy; then
      journalctl -u caddy -n 30 --no-pager | grep -iE "error|fail|bind|denied" | tail -n 5 | sed 's/^/      /' >&2
      die "Caddy не запустился - подробнее: journalctl -u caddy -n 50"
    fi
  fi
}

write_logrotate() {
  cat > /etc/logrotate.d/lab3d <<EOF
$LOG_DIR/*.log $LAB_LOG_DIR/*.log {
	su $APP_USER $APP_USER
	size 5M
	rotate 3
	compress
	missingok
	notifempty
	copytruncate
}
EOF
}

# Веб-панель работает от lab3d и может звать только «lab3d panel-action <имя>» - список действий
# зашит здесь, в копии этого файла у root.
write_sudoers() {
  local tmp; tmp=$(mktemp)
  echo "$APP_USER ALL=(root) NOPASSWD: $INSTALLED_CLI panel-action *" > "$tmp"
  visudo -cqf "$tmp" || die "sudoers не прошёл проверку"
  install -m 440 "$tmp" "$SUDOERS"
  rm -f "$tmp"
}

cmd_config() {
  need_root config
  step "Службы systemd"
  ensure_log_files
  write_units
  systemctl enable lab3d-site lab3d-crm lab3d-slicer >/dev/null 2>&1
  if panel_enabled; then systemctl enable lab3d-panel >/dev/null 2>&1; else systemctl disable --now lab3d-panel >/dev/null 2>&1 || true; fi
  ok "lab3d-site, lab3d-crm, lab3d-slicer$(panel_enabled && echo ", lab3d-panel")"
  step "Caddy (HTTPS)"
  write_caddy
  ok "$CADDY_FILE"
  write_logrotate
  write_sudoers
}

# ---------------------------------------------------------------- статус

since() { systemctl show -p ActiveEnterTimestamp --value "$1" 2>/dev/null | sed 's/^[A-Za-z]* //'; }

show_unit() { # LABEL UNIT [URL]
  local state; state=$(unit_state "$2")
  if ! unit_exists "$2"; then printf '  %-14s %s○ не установлен%s\n' "$1" "$C_DIM" "$C_END"; return; fi
  case $state in
    active) printf '  %-14s %s● работает%s %sс %s%s %s\n' "$1" "$C_OK" "$C_END" "$C_DIM" "$(since "$2")" "$C_END" "${3:-}" ;;
    activating|reloading) printf '  %-14s %s● запускается%s\n' "$1" "$C_WARN" "$C_END" ;;
    *) printf '  %-14s %s○ остановлен%s\n' "$1" "$C_BAD" "$C_END" ;;
  esac
}

cmd_status() {
  local d base; d=$(domain); base=$(base_domain)
  echo
  echo "  Лаборатория 3Д - $ROOT"
  echo
  show_unit "Сайт" lab3d-site "${d:+https://$d}"
  show_unit "Заказы (CRM)" lab3d-crm "$(env_get "$LAB_ENV" DEPLOY_DOMAIN | sed 's#^.\+#https://&#')"
  show_unit "Слайсер" lab3d-slicer "OrcaSlicer $(pinned SlicerOrcaVersion), 127.0.0.1:$(slicer_port)"
  show_unit "Bambuddy" bambuddy "${base:+https://bambu.$base}"
  show_unit "HTTPS (Caddy)" caddy
  show_unit "PostgreSQL" postgresql
  if panel_enabled; then show_unit "Веб-панель" lab3d-panel "https://panel.$base"; else printf '  %-14s %sвыключена - lab3d panel-on%s\n' "Веб-панель" "$C_DIM" "$C_END"; fi
  # Магазин TACLAB - то же приложение, что сайт: работает вместе с ним. Свой домен - если задан и есть в Caddy.
  local shop; shop=$(env_get "$ENV_FILE" TACLAB_DOMAIN); shop=${shop%%,*}
  if [[ -n $shop ]]; then
    if grep -q "^$shop {" "$CADDY_FILE" 2>/dev/null; then
      printf '  %-14s %s %s\n' "Магазин" "https://$shop" "$C_DIM(вместе с сайтом)$C_END"
    else
      printf '  %-14s %s%s нет в конфиге Caddy - выполните: sudo lab3d config%s\n' "Магазин" "$C_WARN" "$shop" "$C_END"
    fi
  else
    printf '  %-14s %s %s\n' "Магазин" "${d:+https://$d/shop}" "${C_DIM}свой домен: sudo lab3d shop-domain shop.$base$C_END"
  fi
  echo
  printf '  %-14s %s\n' "Версия" "$(git -c safe.directory='*' -C "$ROOT" log -1 --format='%h · %cd · %s' --date=format:'%d.%m.%Y %H:%M' 2>/dev/null || echo '-')"
  printf '  %-14s загрузки %s · логи %s · бэкапы %s\n' "Диск" \
    "$(du -sh "$ROOT/uploads" 2>/dev/null | cut -f1)" "$(du -sh "$LOG_DIR" 2>/dev/null | cut -f1)" "$(du -sh "$ROOT/backups" 2>/dev/null | cut -f1 || echo 0)"
  slicer_installed || printf '  %-14s %sне установлен - lab3d slicer%s\n' "Слайсер" "$C_WARN" "$C_END"
  echo
}

# ---------------------------------------------------------------- запуск / остановка

targets_of() { # all|name
  case ${1:-all} in
    all) echo "lab3d-site lab3d-crm lab3d-slicer" ;;
    *) unit_of "$1" ;;
  esac
}

cmd_service() { # start|stop|restart [target]
  local action=$1 target=${2:-all}; need_root "$action" "$target"
  local units; units=$(targets_of "$target")
  # shellcheck disable=SC2086
  systemctl "$action" $units
  [[ $target == all && $action != stop ]] && systemctl reload caddy 2>/dev/null || true
  ok "$action: $units"
}

