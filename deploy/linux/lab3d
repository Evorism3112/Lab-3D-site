# ---------------------------------------------------------------- бэкап

cmd_backup() {
  local out=${1:-$ROOT/backups}
  need_root backup "$@"
  local site_was=0 crm_was=0
  systemctl is-active -q lab3d-site && site_was=1
  systemctl is-active -q lab3d-crm && crm_was=1
  # Остановка на минуту: базы и файлы попадают в архив согласованными.
  if (( site_was || crm_was )); then step "Останавливаю сайт и «Заказы» на время копирования"; systemctl stop lab3d-site lab3d-crm; fi
  local code=0 staging="$ROOT/backups"
  install -d -o "$APP_USER" -g "$APP_USER" -m 700 "$staging"
  as_app bash "$ROOT/deploy/linux/backup.sh" "$staging" || code=$?
  (( site_was )) && systemctl start lab3d-site
  (( crm_was )) && systemctl start lab3d-crm
  [[ $code -eq 0 ]] || die "Резервная копия не создана."
  if [[ $(readlink -f "$out") != $(readlink -f "$staging") ]]; then
    install -d "$out"
    local latest; latest=$(ls -t "$staging"/lab3d-backup-*.tar.gz | head -n1)
    mv "$latest" "$out/" && ok "Перенесено в $out/$(basename "$latest")"
  fi
}

# ---------------------------------------------------------------- восстановление

# Бэкап (с Windows или отсюда) поверх уже установленной системы: её данные заменяются.
cmd_restore() {
  local archive="" domain_arg="" yes=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --domain) domain_arg=$2; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      *) archive=$(readlink -f "$1"); shift ;;
    esac
  done
  [[ -n $archive ]] || die "Укажите архив: sudo lab3d restore /путь/lab3d-backup-….tar.gz"
  need_root restore "$archive" ${domain_arg:+--domain "$domain_arg"} $( ((yes)) && echo --yes)
  [[ -f $archive ]] || die "Нет архива: $archive"
  tar -tzf "$archive" manifest.json >/dev/null 2>&1 || die "Это не бэкап Лаборатории 3Д (нет manifest.json)."

  if (( ! yes )); then
    echo "  Все текущие данные сайта и «Заказов» на этом сервере будут заменены данными из"
    echo "  $archive"
    read -rp "  Продолжить? Напишите «да» или «yes»: " answer
    # «lf» - это «да», набранное на английской раскладке.
    case ${answer,,} in да|yes|y|lf) ;; *) die "Отменено." ;; esac
  fi

  local db_url; db_url=$(env_get "$ENV_FILE" DATABASE_URL)
  [[ $db_url == postgresql://* ]] || die "В $ENV_FILE нет DATABASE_URL - сначала установка: deploy/linux/install.sh"
  local db_name=${db_url##*/}; db_name=${db_name%%\?*}

  step "Останавливаю сайт, «Заказы» и веб-панель"
  systemctl stop lab3d-site lab3d-crm lab3d-panel 2>/dev/null || true

  step "Пустая база $db_name"
  runuser -u postgres -- dropdb --if-exists --force "$db_name"
  runuser -u postgres -- createdb -O "$APP_USER" "$db_name"
  ok "готово"

  install -d -o "$APP_USER" -g "$APP_USER" -m 700 "$ROOT/backups"
  local copy; copy="$ROOT/backups/$(basename "$archive")"
  [[ $archive == "$copy" ]] || install -m 600 -o "$APP_USER" -g "$APP_USER" "$archive" "$copy"
  as_user_in "$ROOT" env DATABASE_URL="$db_url" bash "$ROOT/deploy/linux/restore.sh" "$copy" "$ROOT" --force

  step "Настройки (.env.production, lab/.env)"
  # Домен: указанный, иначе из бэкапа.
  local domain=${domain_arg:-$(env_get "$ENV_FILE" DEPLOY_DOMAIN)}
  apply_env "$domain" "$db_url"

  # Сборка заново: адрес сайта (NEXT_PUBLIC_*) вшивается в неё.
  build_all || die "Сборка не удалась - исправьте ошибку выше и повторите: sudo lab3d update"
  cmd_config
  step "Запуск"
  systemctl restart lab3d-site lab3d-crm
  slicer_installed && systemctl restart lab3d-slicer
  if panel_enabled; then systemctl restart lab3d-panel; fi
  cmd_status
  echo "  Восстановлено. Входы в админку и «Заказы» - те же, что были на Windows."
  echo "  Bambuddy восстанавливается своим бэкапом: http://$(hostname -I | awk '{print $1}'):$(bambuddy_port) -> Настройки -> Резервное копирование."
}

# ---------------------------------------------------------------- веб-панель

cmd_panel_password() {
  need_root panel-password
  local p1 p2
  read -rsp "Новый пароль веб-панели (не короче 10 символов): " p1; echo
  read -rsp "Ещё раз: " p2; echo
  [[ $p1 == "$p2" ]] || die "Пароли не совпали."
  (( ${#p1} >= 10 )) || die "Слишком короткий пароль."
  # Тот же формат, что у Windows (New-PanelPasswordHash): panel.mjs проверяет его так же.
  local hash
  hash=$(PANEL_PW="$p1" node -e '
    const c = require("node:crypto"); const salt = c.randomBytes(16); const it = 210000;
    const h = c.pbkdf2Sync(process.env.PANEL_PW, salt, it, 32, "sha256");
    console.log(`pbkdf2-sha256$${it}$${salt.toString("base64")}$${h.toString("base64")}`);')
  env_set "$ENV_FILE" PANEL_PASSWORD "$hash"
  [[ -n $(env_get "$ENV_FILE" PANEL_SECRET) ]] || env_set "$ENV_FILE" PANEL_SECRET "$(openssl rand -hex 48)"
  [[ -n $(env_get "$ENV_FILE" PANEL_PORT) ]] || env_set "$ENV_FILE" PANEL_PORT 3100
  ok "Пароль сохранён."
  systemctl is-active -q lab3d-panel && systemctl restart lab3d-panel || true
}

cmd_panel_on() {
  need_root panel-on
  [[ -n $(env_get "$ENV_FILE" PANEL_PASSWORD) ]] || die "Сначала задайте пароль: lab3d panel-password"
  [[ -n $(domain) ]] || die "Веб-панель открывается на panel.<домен> - сначала нужен домен."
  env_set "$ENV_FILE" PANEL_ENABLED 1
  cmd_config
  systemctl restart lab3d-panel
  ok "Веб-панель: https://panel.$(base_domain) (DNS-запись A для panel.$(base_domain) -> внешний IP)"
}

cmd_panel_off() {
  need_root panel-off
  env_set "$ENV_FILE" PANEL_ENABLED 0
  cmd_config
  ok "Веб-панель выключена."
}

# Только эти действия доступны веб-панели (через sudo, см. write_sudoers).
cmd_panel_action() {
  [[ $EUID -eq 0 ]] || die "Только через sudo."
  case ${1:-} in
    site-restart) systemctl restart lab3d-site; slicer_installed && systemctl restart lab3d-slicer; systemctl reload caddy; ok "Сайт перезапущен." ;;
    site-update) FROM_PANEL=1; cmd_update ;;
    crm-start|crm-stop|crm-restart) systemctl "${1#crm-}" lab3d-crm; ok "«Заказы»: ${1#crm-}" ;;
    bambuddy-start|bambuddy-stop|bambuddy-restart) systemctl "${1#bambuddy-}" bambuddy; ok "Bambuddy: ${1#bambuddy-}" ;;
    *) die "Неизвестное действие: ${1:-}" ;;
  esac
}

# ---------------------------------------------------------------- магазин TACLAB

cmd_shop_domain() {
  need_root shop-domain "$@"
  local domain=${1:-}
  domain=${domain#https://}; domain=${domain%/}
  if [[ -n $domain && ! $domain =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(,[a-z0-9]([a-z0-9.-]*[a-z0-9])?)*$ ]]; then
    die "Домен: латиница, цифры, точки и дефисы (несколько - через запятую)"
  fi
  env_set "$ENV_FILE" TACLAB_DOMAIN "$domain"
  cmd_config
  # proxy.ts читает домен при запуске сайта.
  systemctl restart lab3d-site
  if [[ -n $domain ]]; then
    ok "Магазин: https://${domain%%,*} (DNS-запись A -> внешний IP; сертификат Caddy выпустит сам)"
  else
    ok "Свой домен у магазина убран: он открывается на https://$(domain)/shop"
  fi
}

# ---------------------------------------------------------------- main

# deploy/linux/install.sh подключает этот файл ради функций - тогда команд не выполняем.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

cmd=${1:-status}; shift || true
case $cmd in
  status) cmd_status ;;
  start|stop|restart) cmd_service "$cmd" "$@" ;;
  logs) cmd_logs "$@" ;;
  update) cmd_update "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  slicer) cmd_slicer_install ;;
  slicer-test) cmd_slicer_test ;;
  db-push) cmd_db_push ;;
  config) cmd_config ;;
  build) need_root build; build_all ;;
  panel-password) cmd_panel_password ;;
  panel-on) cmd_panel_on ;;
  panel-off) cmd_panel_off ;;
  panel-action) cmd_panel_action "$@" ;;
  shop-domain) cmd_shop_domain "$@" ;;
  git-check) cmd_git_check "${1:-fetch}" ;;
  help|-h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "Неизвестная команда: $cmd (lab3d help)" ;;
esac
