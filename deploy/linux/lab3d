    bambuddy) exec journalctl -u bambuddy -n 200 -f ;;
    *) die "Логи: site, site-errors, crm, crm-errors, slicer, panel, caddy, bambuddy" ;;
  esac
}

# ---------------------------------------------------------------- сборка и база

# prisma db push без того, кто ответит на вопрос: если все предупреждения - только новые
# уникальные индексы (данные не удаляются), подтверждаем; иначе - стоп, решает человек.
db_push() {
  local out code=0
  out=$(as_app npx prisma db push </dev/null 2>&1) || code=$?
  sed 's/^/    /' <<<"$out"
  [[ $code -eq 0 ]] && return 0
  grep -q "There might be data loss" <<<"$out" || return 1
  local warnings
  warnings=$(sed -n '/There might be data loss/,$p' <<<"$out" | tail -n +2 | grep -v '^[[:space:]]*$' | grep -v '^[[:space:]]*Error:' || true)
  if [[ -z $warnings ]] || grep -qv "A unique constraint covering the columns .* will be added" <<<"$warnings"; then
    warn "Изменение схемы может удалить данные - автоматически не применяется. Проверьте предупреждения и выполните: lab3d db-push"
    return 1
  fi
  ok "Добавляются только уникальные индексы (данные не удаляются) - подтверждаю."
  as_app npx prisma db push --accept-data-loss 2>&1 | sed 's/^/    /'
}

build_all() {
  step "Зависимости сайта"
  as_app npm install --no-audit --no-fund
  step "Клиент базы"
  as_app npx prisma generate
  step "Схема базы"
  db_push || return 1
  step "Сборка сайта"
  as_app npm run build
  step "Зависимости «Заказов»"
  as_user_in "$LAB" npm install --no-audit --no-fund
}

cmd_db_push() { need_root db-push; as_app npx prisma db push; }

# ---------------------------------------------------------------- обновление

cmd_git_check() {
  local fetch=${1:-fetch}
  local runner=(); [[ $EUID -eq 0 ]] && runner=(runuser -u "$APP_USER" --)
  ( cd "$ROOT" && "${runner[@]}" env HOME="$APP_HOME" node - "$ROOT" "$fetch" <<'JS'
const { execFileSync } = require("node:child_process");
const [root, mode] = process.argv.slice(2);
const git = (...args) => execFileSync("git", ["-c", "core.quotepath=off", "-c", "safe.directory=*", "-C", root, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
const tryGit = (...a) => { try { return git(...a); } catch { return null; } };
const info = { gitInstalled: true, isRepo: false, hasCommits: false, branch: "", upstream: "", remote: "", head: "", headDate: "", headMessage: "", behind: 0, ahead: 0, dirty: 0, commits: [], error: "" };
if (tryGit("rev-parse", "--git-dir") !== null) {
  info.isRepo = true;
  info.hasCommits = tryGit("rev-parse", "--verify", "--quiet", "HEAD") !== null;
  info.remote = tryGit("remote", "get-url", "origin") ?? "";
  if (info.hasCommits) {
    info.branch = tryGit("rev-parse", "--abbrev-ref", "HEAD") ?? "";
    const [h, d, ...m] = (tryGit("log", "-1", "--format=%h|%cd|%s", "--date=format:%d.%m.%Y %H:%M") ?? "").split("|");
    Object.assign(info, { head: h ?? "", headDate: d ?? "", headMessage: m.join("|") });
    info.dirty = (tryGit("status", "--porcelain", "-uno") ?? "").split("\n").filter(Boolean).length;
    if (mode === "fetch" && info.remote) {
      try { git("fetch", "--quiet"); } catch (e) { info.error = String(e.stderr || e.message).trim(); }
    }
    info.upstream = tryGit("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}") ?? "";
    if (info.upstream) {
      info.behind = Number(tryGit("rev-list", "--count", "HEAD..@{u}") ?? 0);
      info.ahead = Number(tryGit("rev-list", "--count", "@{u}..HEAD") ?? 0);
      info.commits = (tryGit("log", "HEAD..@{u}", "--format=%h  %s", "-n", "30") ?? "").split("\n").filter(Boolean);
    }
  }
}
console.log(JSON.stringify(info));
JS
  )
}

git_pull() { # force?
  local force=$1 info behind
  [[ -d $ROOT/.git ]] || { dim "Папка не подключена к git - код не обновляется."; return 0; }
  step "Получение обновлений (git)"
  info=$(cmd_git_check fetch)
  local error upstream; error=$(node -pe 'JSON.parse(process.argv[1]).error' "$info"); upstream=$(node -pe 'JSON.parse(process.argv[1]).upstream' "$info")
  behind=$(node -pe 'JSON.parse(process.argv[1]).behind' "$info")
  [[ -z $error ]] || die "Не удалось связаться с репозиторием: $error"
  [[ -n $upstream ]] || die "Ветка не привязана к удалённому репозиторию."
  if [[ $behind == 0 ]]; then ok "Код уже актуален."; return 0; fi
  ok "Новых коммитов: $behind"
  node -e 'for (const c of JSON.parse(process.argv[1]).commits) console.log("    " + c)' "$info"
  if as_user_in "$ROOT" git -c safe.directory='*' pull --ff-only; then ok "Код обновлён."; return 0; fi
  [[ $force == 1 ]] || die "git pull не удался: локальные изменения мешают. Принудительно: lab3d update --force"
  warn "Принудительное обновление: локальные изменения отбрасываются."
  as_user_in "$ROOT" git -c safe.directory='*' reset --hard '@{u}'
}

# Копия команды у root обновляется только когда update запускает человек, а не веб-панель:
# панель пишет в папку проекта, и её файл не должен попадать к root. Признак ставит
# только cmd_panel_action (переменная из окружения сюда не доходит - задаётся ниже).
FROM_PANEL=0
refresh_cli() {
  [[ -f $INSTALLED_CLI ]] || return 0
  local tmp; tmp=$(mktemp)
  sed "s#@LAB3D_ROOT@#$ROOT#" "$ROOT/deploy/linux/lab3d" > "$tmp"
  if cmp -s "$tmp" "$INSTALLED_CLI"; then rm -f "$tmp"; return 0; fi
  if [[ $FROM_PANEL == 1 ]]; then
    warn "Вышла новая версия команды lab3d. Из веб-панели её поставить нельзя - выполните на сервере: sudo lab3d update"
  else
    install -m 755 -o root -g root "$tmp" "$INSTALLED_CLI"; ok "Команда lab3d обновлена."
  fi
  rm -f "$tmp"
}

cmd_update() {
  local force=0; [[ ${1:-} == --force ]] && force=1
  need_root update "$@"
  git_pull "$force"
  local site_was=0; systemctl is-active -q lab3d-site && site_was=1
  step "Останавливаю сайт на время сборки"
  systemctl stop lab3d-site
  if ! build_all; then
    bad "Обновление не завершено."
    [[ $site_was == 1 ]] && { warn "Запускаю сайт снова, чтобы он не остался выключенным."; systemctl start lab3d-site || true; }
    exit 1
  fi
  if slicer_installed && ! slicer_current; then
    step "Закреплённая версия слайсера сменилась - переустанавливаю"
    cmd_slicer_install soft || warn "Слайсер не обновился - сайт работает, цены по договорённости."
  fi
  cmd_config
  refresh_cli
  step "Запуск"
  systemctl restart lab3d-site lab3d-crm
  slicer_installed && systemctl restart lab3d-slicer
  ok "Готово: $(git -c safe.directory='*' -C "$ROOT" log -1 --format='%h %s')"
  # Последней и без ожидания: из веб-панели этот процесс живёт внутри её службы.
  if panel_enabled; then systemctl restart --no-block lab3d-panel; fi
}

