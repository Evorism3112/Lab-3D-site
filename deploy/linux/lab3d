cmd_logs() {
  local source=${1:-site}
  case $source in
    site) exec tail -n 200 -F "$LOG_DIR/next.log" ;;
    site-errors) exec tail -n 200 -F "$LOG_DIR/next-error.log" ;;
    crm) exec tail -n 200 -F "$LAB_LOG_DIR/app.log" ;;
    crm-errors) exec tail -n 200 -F "$LAB_LOG_DIR/app-error.log" ;;
